<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Components.CardShell"
             x:Name="Root">

    <Border Padding="10" Margin="0,0,0,12">

        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding TapCommand, Source={x:Reference Root}}"
                CommandParameter="{Binding TapCommandParameter, Source={x:Reference Root}}"/>
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="12">

            <ContentView Grid.Column="0"
                         Content="{Binding LeftContent, Source={x:Reference Root}}"
                         HeightRequest="90" WidthRequest="90"/>

            <ContentView Grid.Column="1"
                         Content="{Binding DetailsContent, Source={x:Reference Root}}"
                         VerticalOptions="Center"/>

            <ContentView Grid.Column="2"
                         Content="{Binding TrailingContent, Source={x:Reference Root}}"
                         VerticalOptions="Center"/>

        </Grid>
    </Border>
</ContentView>