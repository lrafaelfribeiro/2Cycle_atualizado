<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Components.StatCardView"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Name="Root">

    <VerticalStackLayout
        Spacing="4"
        HorizontalOptions="Center">

        <Image
            Source="{Binding Image, Source={x:Reference Root}}"
            HeightRequest="30">
            <Image.Behaviors>
                <toolkit:IconTintColorBehavior
                    TintColor="{StaticResource Primary}" />
            </Image.Behaviors>    
        </Image>
        
        <Label Style="{StaticResource LabelSubtitle}"
               Text="{Binding Label, Source={x:Reference Root}}"
               HorizontalOptions="Center"/>

        <Label Style="{StaticResource LabelValue}" Text="{Binding Value, Source={x:Reference Root}}" HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentView>
