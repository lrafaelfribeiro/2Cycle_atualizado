<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Components.PasswordEntryView"
             x:Name="Root">
    <Border Style="{StaticResource InputContainer}">
        <Grid ColumnDefinitions="*,Auto">
            <Entry
                x:Name="PasswordEntry"
                Grid.Column="0"
                Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                IsPassword="{Binding IsPasswordHidden, Source={x:Reference Root}}"
                Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                ReturnType="{Binding ReturnType, Source={x:Reference Root}}"
                ReturnCommand="{Binding ReturnCommand, Source={x:Reference Root}}"
                IsEnabled="{Binding IsEnabled, Source={x:Reference Root}}"/>

            <ImageButton
                Grid.Column="1"
                Source="{Binding IsPasswordHidden, Source={x:Reference Root}, Converter={StaticResource BoolToEyeIconConverter}}"
                Clicked="OnToggleClicked"
                BackgroundColor="Transparent"
                WidthRequest="24"
                HeightRequest="24"
                VerticalOptions="Center"
                IsEnabled="{Binding IsEnabled, Source={x:Reference Root}}"/>
        </Grid>
    </Border>
</ContentView>