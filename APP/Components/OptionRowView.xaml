<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Components.OptionRowView"
             x:Name="Root">
    <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="16">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"/>
        </Grid.GestureRecognizers>

        <Image Grid.Column="0"
               Source="{Binding IconSource, Source={x:Reference Root}}"
               HeightRequest="20" WidthRequest="20"
               VerticalOptions="Center"/>

        <Label Grid.Column="1"
               Style="{StaticResource LabelBody}"
               Text="{Binding Text, Source={x:Reference Root}}"
               TextColor="{Binding TextColor, Source={x:Reference Root}}"
               VerticalOptions="Center"/>
    </Grid>
</ContentView>
