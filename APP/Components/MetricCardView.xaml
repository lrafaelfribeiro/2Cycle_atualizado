<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="APP.Components.MetricCardView"
             x:Name="Root">
    <VerticalStackLayout HorizontalOptions="Center" Spacing="7">

        <Image Source="{Binding IconSource, Source={x:Reference Root}}"
               HeightRequest="35" WidthRequest="35"
               HorizontalOptions="Center">
            <Image.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="{Binding IconColor, Source={x:Reference Root}}"/>
            </Image.Behaviors>
        </Image>

        <Label Style="{StaticResource LabelSubtitle}"
               Text="{Binding Label, Source={x:Reference Root}}"
               HorizontalOptions="Center"/>

        <Label Text="{Binding Value, Source={x:Reference Root}}"
               FontSize="40"
               FontAttributes="Bold"
               TextColor="{StaticResource TextPrimary}"
               HorizontalOptions="Center"/>

        <Label Style="{StaticResource LabelSubtitle}"
               Text="{Binding Unit, Source={x:Reference Root}}"
               HorizontalOptions="Center"/>

    </VerticalStackLayout>
</ContentView>
