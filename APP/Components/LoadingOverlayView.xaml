<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Components.LoadingOverlayView"
             x:Name="Root">

    <Grid IsVisible="{Binding IsLoading, Source={x:Reference Root}}"
          BackgroundColor="{StaticResource OverlayScrim}"
          InputTransparent="False">

        <VerticalStackLayout HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Spacing="12">

            <ActivityIndicator IsRunning="{Binding IsLoading, Source={x:Reference Root}}"
                                Color="{StaticResource Primary}"
                                WidthRequest="40"
                                HeightRequest="40"/>

            <Label Text="{Binding Message, Source={x:Reference Root}}"
                   Style="{StaticResource LabelSmall}"
                   IsVisible="{Binding Message, Source={x:Reference Root}, Converter={StaticResource StringToBoolConverter}}"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </Grid>
</ContentView>