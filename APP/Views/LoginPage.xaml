<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Views.LoginPage"
             xmlns:components="clr-namespace:APP.Components">

    <Grid>

        <!-- FOTO DE FUNDO -->
        <Image
            Source="background_overlay.jpg"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"/>

        <!-- CONTEÚDO -->
        <ScrollView>
            <VerticalStackLayout
                Margin="0,250,0,0"
                Padding="30,0"
                Spacing="8"
                IsEnabled="{Binding IsNotBusy}">

                <Label Text="Email"
                       Style="{StaticResource LabelSubtitle}"/>

                <Border Style="{StaticResource InputContainer}"
                        Margin="0,4,0,16">
                    <Entry x:Name="EmailEntry"
                           Keyboard="Email"
                           VerticalOptions="Center"
                           Text="{Binding Email}"
                           ReturnType="Next"
                           Completed="EmailEntry_Completed"
                           IsEnabled="{Binding IsNotBusy}"/>
                </Border>

                <Label Text="Password"
                       Style="{StaticResource LabelSubtitle}"/>

                <components:PasswordEntryView
                    x:Name="PasswordEntryControl"
                    Text="{Binding Password}"
                    Placeholder="A tua password"
                    ReturnType="Go"
                    ReturnCommand="{Binding LoginCommand}"
                    IsEnabled="{Binding IsNotBusy}"/>

                <Label Style="{StaticResource LabelAlert}"
                       x:Name="ErrorLabel"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage}"
                       Margin="0,0,0,16"/>

                <Button Text="Entrar"
                        Margin="0,20,0,12"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>

                <Button Text="Criar conta"
                        Style="{StaticResource ButtonOutline}"
                        Command="{Binding GoToRegisterCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- OVERLAY DE BLOQUEIO — a rede de segurança real -->
        <Grid
            IsVisible="{Binding IsBusy}"
            InputTransparent="False"
            BackgroundColor="#66000000">
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Color="White"/>
        </Grid>

    </Grid>

</ContentPage>